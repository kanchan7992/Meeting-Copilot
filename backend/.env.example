# Copy to backend/.env (git-ignored) and fill in. Never commit real keys.

# --- server ---
APP_ENV=dev                      # dev | prod
APP_HOST=127.0.0.1
APP_PORT=8765
APP_AUTH_TOKEN_SHA256=           # from: python -m app.tools.make_token
APP_AUTH_DISABLED=false          # dev only; refused when APP_ENV=prod
DATABASE_URL=                    # empty = SQLite in backend/data; prod: postgresql+asyncpg://user@host/db

# --- answers ---
ANSWER_MODE=direct               # direct (fastest, model knowledge only) | web | kb
OWNER_NAME=Pradeep Singh
COMPANY_BRIEF_PATH=              # empty = backend/company_brief.md
AUTO_ANSWER=true                 # answer client questions automatically
AUTO_ANSWER_MIN_WORDS=4
VAD_SILENCE_MS=600               # pause that ends an utterance; lower = faster, more cut-offs

# --- default profile: any provider, chosen here ---
LLM_PROVIDER=groq                # groq | openai | anthropic | google_genai | ollama | openai_compatible | fake
LLM_MODEL=openai/gpt-oss-20b     # e.g. openai/gpt-oss-120b, gpt-4.1-mini, claude-haiku-4-5, gemini-2.5-flash
LLM_BASE_URL=                    # only for openai_compatible (vLLM, LiteLLM)
LLM_KWARGS={"reasoning_effort": "low"}   # provider-specific JSON; use {} for models without reasoning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700

STT_PROVIDER=groq                # groq | openai | deepgram | openai_compatible | fake
STT_MODEL=whisper-large-v3-turbo
STT_BASE_URL=                    # only for openai_compatible (self-hosted faster-whisper server)
STT_LANGUAGE=                    # e.g. en, hi; empty = auto-detect

SEARCH_PROVIDER=none             # none | tavily | brave | searxng  (used only in web mode)
SEARCH_BASE_URL=                 # searxng only

# --- provider keys (only the ones you use) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- confidential profile: self-hosted endpoints only ---
CONF_ENABLED=false
CONF_ALLOWED_HOSTS=localhost,127.0.0.1
CONF_LLM_PROVIDER=openai_compatible
CONF_LLM_BASE_URL=               # e.g. http://10.0.0.20:8000/v1 (vLLM)
CONF_LLM_MODEL=
CONF_STT_PROVIDER=openai_compatible
CONF_STT_BASE_URL=               # e.g. http://10.0.0.21:8000/v1 (faster-whisper server)
CONF_STT_MODEL=whisper-large-v3-turbo
CONF_SEARCH_PROVIDER=none
